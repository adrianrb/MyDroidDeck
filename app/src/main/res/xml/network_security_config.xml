<?xml version="1.0" encoding="utf-8"?>
<!-- Dev/LAN build: the deck talks to a LAN FastAPI server. Cleartext HTTP stays
     allowed as a fallback, and the server's self-signed dev certificate
     (res/raw/mydroiddeck_server.pem, regenerated by server/deploy/gen-cert.sh)
     is trusted in addition to the system roots. Tighten this for production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/mydroiddeck_server" />
        </trust-anchors>
    </base-config>
</network-security-config>
