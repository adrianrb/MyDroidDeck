# Copy to `.env` (gitignored) and change the values.
# The pairing code is the shared secret a device must enter once to pair.
MYDROIDDECK_PAIRING_CODE=change-me
MYDROIDDECK_DATABASE_URL=sqlite:///./data/mydroiddeck.db
# How dispatched actions run: "wsl" launches Windows executables via WSL interop
# (powershell.exe Start-Process); "dry-run" only records the attempt (tests/CI).
# MYDROIDDECK_EXEC_ENGINE=wsl
# MYDROIDDECK_EXEC_TIMEOUT_SECONDS=20